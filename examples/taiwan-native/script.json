  "pre": 0.15,
  "lines": [
    {
      "id": "b01",
      "text": "台北市長辯論，一句話就能洗版？"
    },
    {
      "id": "b02",
      "text": "沈伯洋開場先祝蔣萬安身體健康，接著說要把麥克風交給市民。"
    },
    {
      "id": "b03",
      "text": "欸，這兩句確實好剪。"
    },
    {
      "id": "b04",
      "text": "但選民要看的，是政見怎麼做。"
    },
    {
      "id": "b05",
      "text": "聽起來好聽，不等於做得到；講得很嗆，也不等於比較會做事。"
    },
    {
      "id": "b06",
      "text": "要拆招，就把財源、期程、權責拿出來比。"
    },
    {
      "id": "b07",
      "text": "關鍵不是誰的聲量最大，是誰把市政說清楚。"
    }
  ],
  "region": "taiwan"
}
