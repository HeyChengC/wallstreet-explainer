  "pre": 0.15,
  "lines": [
    {
      "id": "b01",
      "text": "講咗咁耐，點解又押後？講緊二零二四年嘅垃圾徵費。"
    },
    {
      "id": "b02",
      "text": "原先話八月一號行，五月尾又宣布暫緩。"
    },
    {
      "id": "b03",
      "text": "政府話，社會準備未夠，回收配套仲要加。"
    },
    {
      "id": "b04",
      "text": "好，配套唔夠就唔應該夾硬推。"
    },
    {
      "id": "b05",
      "text": "但係，街坊最想知嘅係：之前啲宣傳同準備，做成點？"
    },
    {
      "id": "b06",
      "text": "邊啲問題已經執好，邊啲仲未？"
    },
    {
      "id": "b07",
      "text": "記者有追問問責，政府就話局長已經盡心盡力。"
    },
    {
      "id": "b08",
      "text": "盡力係一回事，交代清楚係另一回事。"
    },
    {
      "id": "b09",
      "text": "講到尾，唔好淨係叫市民配合，局方自己條數，都要講清楚。"
    }
  ],
  "region": "hongkong"
}
